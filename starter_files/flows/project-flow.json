    {
        "id": "76f5767adbcb5ff1",
        "type": "function",
        "z": "1bee8c8292e87584",
        "name": "Sign Data",
        "func": "var rawData = JSON.stringify(msg.payload);\nvar hash = 0;\nfor (var i = 0; i < rawData.length; i++) {\n    hash = ((hash << 5) - hash) + rawData.charCodeAt(i);\n    hash |= 0;\n}\nmsg.payload = {\n    data: msg.payload,\n    signature: hash.toString()\n};\nreturn msg;",
