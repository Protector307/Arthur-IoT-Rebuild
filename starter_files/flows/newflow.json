    {
        "id": "ea061cf20f433ed0",
        "type": "function",
        "z": "9b8b18889de113c3",
        "name": "Verify Integrity",
        "func": "var incoming = msg.payload;\nvar rawData = JSON.stringify(incoming.data);\nvar checkHash = 0;\n\nfor (var i = 0; i < rawData.length; i++) {\n    checkHash = ((checkHash << 5) - checkHash)\n        + rawData.charCodeAt(i);\n    checkHash |= 0;\n}\n\nif (checkHash.toString() === incoming.signature) {\n    msg.payload = \"VERIFIED: \" + rawData;\n    return [msg, null];\n} else {\n    msg.payload = \"INTEGRITY ALERT: Tampering detected!\";\n    return [null, msg];\n}",
        "outputs": 2,
        "timeout": 0,
