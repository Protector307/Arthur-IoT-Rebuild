    {
        "id": "cfc6445bace7e687",
        "type": "function",
        "z": "9b8b18889de113c3",
        "name": "Sign Data",
        "func": "var rawData = JSON.stringify(msg.payload);\nvar hash = 0;\n\nfor (var i = 0; i < rawData.length; i++) {\n    hash = ((hash << 5) - hash) + rawData.charCodeAt(i);\n    hash |= 0;\n}\n\nmsg.payload = {\n    data: msg.payload,\n    signature: hash.toString()\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
